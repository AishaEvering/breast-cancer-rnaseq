
# ==========================================
# Breast Cancer RNA-seq Pipeline
# Git Ignore Configuration
# ==========================================

# Raw and processed sequencing data
data/raw/*
data/processed/*

# Preserve directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep

# Large sequencing and alignment files
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.sam
*.cram
*.sra

# Compressed data archives
*.tar
*.tar.gz
*.zip
*.gz

# Python cache and temporary files
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# Local Python environments
.venv/
venv/
env/

# R session files
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# Quarto generated files
.quarto/
*_files/
*_cache/

# macOS files
.DS_Store
.AppleDouble

# IDE configuration
.vscode/
.idea/

# Temporary files
*.tmp
*.log
*~
